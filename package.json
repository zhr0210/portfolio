{
  "name": "kilian-continuum",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Kilian Zhou Continuum portfolio static site",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start": "npm run preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src tests vite.config.ts index.html",
    "format:check": "prettier --check src tests vite.config.ts index.html"
  },
  "dependencies": {
    "gsap": "^3.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
